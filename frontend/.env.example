# Get these values from Firebase Console > Project Settings > General > Your apps > Web app config
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=ce-customizable-art-site.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ce-customizable-art-site
VITE_FIREBASE_STORAGE_BUCKET=ce-customizable-art-site.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Backend API URL (default is localhost:5000 during development)
VITE_API_URL=http://localhost:5000
